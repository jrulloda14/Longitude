{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react", "module": "ESNext",
    "moduleResolution": "Bundler", "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowJs": true, "isolatedModules": true, "noUnusedLocals": true
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/browser/**/*.ts", "tests/browser/**/*.tsx"]
}
