{
  "name": "longitude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^24.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:test": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "desktop:frontend": "node scripts/prepare-desktop.mjs",
    "desktop:devfrontend": "node scripts/write-native-notices.mjs && npm run dev",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "visual:capture": "node scripts/capture-visual.mjs",
    "build": "npm run typecheck && vite build && node scripts/write-notices.mjs --dist",
    "build:prototype": "node build.mjs prototype-dist && node scripts/write-notices.mjs --prototype-dist",
    "preview": "vite preview --host 127.0.0.1",
    "perf": "node scripts/measure-performance.mjs",
    "licenses": "node scripts/write-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "0.441.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
