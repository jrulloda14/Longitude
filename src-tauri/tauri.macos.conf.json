{
  "$schema": "https://schema.tauri.app/config/2",
  "build": { "features": ["macos-transparency"] },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      { "label": "main", "create": false, "title": "Longitude", "width": 850, "height": 560, "minWidth": 380, "minHeight": 480, "center": true, "visible": false, "decorations": true, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 14, "y": 14 } },
      { "label": "widget", "create": false, "title": "Longitude Widget", "width": 264, "height": 248, "minWidth": 264, "maxWidth": 264, "visible": false, "decorations": false, "transparent": true, "shadow": false, "resizable": false, "skipTaskbar": true, "alwaysOnTop": true, "visibleOnAllWorkspaces": true }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "category": "Productivity",
    "macOS": { "minimumSystemVersion": "12.0", "hardenedRuntime": true, "signingIdentity": null, "infoPlist": "macos/Info.plist" }
  }
}
